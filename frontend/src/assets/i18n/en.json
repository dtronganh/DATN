  "about": {
    "title": "About Us",
    "story": {
      "label": "Our Story",
      "title": "Gear Store – Where Technology Meets Passion",
      "paragraph1": "At Gear Store, our story is one of passion, expertise, and a relentless pursuit of excellence. It all began with a vision to redefine the way people experience technology – not just as devices, but as tools that empower creativity, productivity, and performance. Driven by a love for innovation and a commitment to quality, we embarked on a journey to bring the best gear to every enthusiast.",
      "paragraph2": "Over the years, our dedication to innovation and customer satisfaction has fueled our growth and earned us a reputation for excellence. From humble beginnings, Gear Store has grown into a trusted name in the tech retail industry, known for delivering products that exceed expectations."
    },
    "stats": {
      "customers": "Happy Customers",
      "products": "Products Available",
      "years": "Years of Experience",
      "support": "Support 24/7",
      "rating": "Average Rating"
    },
    "why": {
      "label": "Why Choose Us",
      "title": "Why Choose Gear Store",
      "subtitle": "We stand out with genuine products, competitive prices, and dedicated technical support for every customer."
    },
    "features": {
      "1": {
        "title": "Genuine Products",
        "desc": "Every item we sell is 100% authentic, sourced directly from official distributors and manufacturers worldwide."
      },
      "2": {
        "title": "Expert Support",
        "desc": "Our technical team provides professional advice and dedicated after-sales support to keep you performing at your best."
      },
      "3": {
        "title": "Premium Warranty",
        "desc": "All products come with full manufacturer warranty plus our dedicated in-store service guarantee for complete peace of mind."
      },
      "4": {
        "title": "Best Prices",
        "desc": "We offer highly competitive pricing and regular promotions to make the latest technology accessible to everyone."
      },
      "5": {
        "title": "Nationwide Shipping",
        "desc": "Fast and reliable delivery across the country with real-time order tracking from warehouse to your doorstep."
      },
      "6": {
        "title": "Trusted Reviews",
        "desc": "Thousands of verified customer reviews help you make the most informed purchase decisions with confidence."
      }
